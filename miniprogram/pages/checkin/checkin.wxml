<view class="page">
  <view class="card status-card">
    <block wx:if="{{loading}}">
      <view class="status-title">加载中</view>
      <view class="status-text">请稍候，正在获取今天正在进行的培训。</view>
    </block>

    <block wx:elif="{{result}}">
      <view class="status-title ok">{{result.already_checked ? '您已签到' : '签到成功'}}</view>
      <view class="session-title">{{result.title}}</view>
      <view class="info-row"><text>时间</text><text>{{result.start_at}}</text></view>
      <view class="info-row"><text>地点</text><text>{{result.location || '-'}}</text></view>
      <view class="info-row"><text>单位</text><text>{{result.organization_name}}</text></view>
      <view class="info-row"><text>学时</text><text>{{result.duration_minutes}} 分钟</text></view>
      <button class="btn-primary" bindtap="goMe">查看我的培训记录</button>
    </block>

    <block wx:elif="{{activeList.length}}">
      <view class="status-title">选择培训场次</view>
      <view class="status-text">以下为全市今天正在进行的培训，请选择您所在现场加入。</view>
      <block wx:for="{{activeList}}" wx:key="session_id">
        <view
          class="training-item {{selectedSessionId === item.session_id ? 'selected' : ''}}"
          data-id="{{item.session_id}}"
          bindtap="onPickTraining"
        >
          <view class="training-title">{{item.title}}</view>
          <view class="training-meta">{{item.organization_name}} · {{item.district_name}}</view>
          <view class="training-meta">{{item.start_at}} · {{item.duration_minutes}} 分钟</view>
          <view wx:if="{{item.location}}" class="training-meta">地点：{{item.location}}</view>
        </view>
      </block>
      <button class="btn-primary" loading="{{loading}}" bindtap="submitCheckin">加入培训</button>
    </block>

    <block wx:else>
      <view class="status-title bad">暂无可加入培训</view>
      <view class="status-text">{{error || '今天暂无正在进行的培训场次'}}</view>
    </block>
  </view>
</view>
