<view class="page">
  <view class="card status-card">
    <block wx:if="{{loading}}">
      <view class="status-title">正在签到</view>
      <view class="status-text">请稍候，正在记录本次培训。</view>
    </block>

    <block wx:elif="{{result}}">
      <view class="status-title ok">{{result.already_checked ? '您已签到' : '签到成功'}}</view>
      <view class="session-title">{{result.title}}</view>
      <view class="info-row"><text>时间</text><text>{{result.start_at}}</text></view>
      <view class="info-row"><text>地点</text><text>{{result.location || '-'}}</text></view>
      <view class="info-row"><text>单位</text><text>{{result.organization_name}}</text></view>
      <view class="info-row"><text>学时</text><text>{{result.duration_minutes}} 分钟</text></view>
      <button class="btn-primary" bindtap="goMe">查看我的培训记录</button>
    </block>

    <block wx:else>
      <view class="status-title bad">无法签到</view>
      <view class="status-text">{{error || '签到码无效，请重新扫码'}}</view>
    </block>
  </view>
</view>
