<view class="page">
  <view class="hint-card">
    <view class="hint-title">微信账号</view>
    <view class="hint-text">您已通过微信登录，系统将把您的信息与当前微信号绑定。</view>
  </view>

  <view class="card">
    <view class="label">所属区县 <text class="req">*</text></view>
    <picker mode="selector" range="{{districtNames}}" value="{{districtIndex}}" bindchange="onDistrictChange">
      <view class="picker-val">{{districtNames[districtIndex] || '请选择区县'}}</view>
    </picker>

    <view class="label">所在单位 <text class="req">*</text></view>
    <picker mode="selector" range="{{orgPickerLabels}}" value="{{orgIndex}}" bindchange="onOrgPick">
      <view class="picker-val">
        {{selectedOrg ? selectedOrg.name : '请选择单位（如不在列表请选「其他单位」）'}}
      </view>
    </picker>

    <block wx:if="{{showCustomOrg}}">
      <view class="label">新单位名称 <text class="req">*</text></view>
      <input class="input" placeholder="请输入完整单位全称" value="{{customOrgName}}" bindinput="onCustomOrgName" />

      <view class="label">单位类型</view>
      <picker mode="selector" range="{{customOrgTypeOptions}}" value="{{customOrgTypeIndex}}" bindchange="onCustomOrgTypeChange">
        <view class="picker-val">{{customOrgTypeOptions[customOrgTypeIndex]}}</view>
      </picker>
    </block>

    <view class="label">姓名 <text class="req">*</text></view>
    <input class="input" placeholder="真实姓名" value="{{name}}" bindinput="onName" />

    <view class="label">手机号 <text class="req">*</text></view>
    <input class="input" type="number" maxlength="11" placeholder="11位手机号" value="{{phone}}" bindinput="onPhone" />

    <view class="label">职务/岗位</view>
    <input class="input" placeholder="选填，如：消防安全管理人" value="{{jobTitle}}" bindinput="onJobTitle" />

    <button class="btn-primary" loading="{{loading}}" bindtap="submit">提交注册</button>
  </view>
</view>
