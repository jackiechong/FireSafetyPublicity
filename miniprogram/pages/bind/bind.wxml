<view class="page">
  <view class="hint-card">
    <view class="hint-title">微信账号</view>
    <view class="hint-text">您已通过微信登录，系统将把您的信息与当前微信号绑定。</view>
  </view>

  <view class="card">
    <view class="label">所属区县 <text class="req">*</text></view>
    <picker mode="selector" range="{{districtNames}}" value="{{districtIndex}}" bindchange="onDistrictChange">
      <view class="picker-val">{{districtNames[districtIndex] || '请选择区县'}}</view>
    </picker>

    <view class="label">所在单位 <text class="req">*</text></view>
    <input class="input" placeholder="输入单位名称，可联想选择或手动新增" value="{{orgKeyword}}" bindinput="onOrgInput" />
    <scroll-view wx:if="{{orgList.length}}" scroll-y class="org-list">
      <view
        wx:for="{{orgList}}"
        wx:key="id"
        class="org-item {{selectedOrg && selectedOrg.id === item.id ? 'on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onPickOrg"
      >
        <view class="org-name">{{item.name}}</view>
        <view class="org-type">{{item.district_name || ''}} · {{orgTypeName(item.org_type)}}</view>
      </view>
    </scroll-view>

    <view wx:if="{{selectedOrg}}" class="selected-tip">
      已选择：{{selectedOrg.name}}，类型：{{orgTypeName(selectedOrg.org_type)}}
    </view>
    <view wx:elif="{{orgKeyword}}" class="selected-tip">未选择已有单位，将按输入内容新增单位，单位类型默认归为其他部门</view>

    <view class="label">姓名 <text class="req">*</text></view>
    <input class="input" placeholder="真实姓名" value="{{name}}" bindinput="onName" />

    <view class="label">手机号 <text class="req">*</text></view>
    <input class="input" type="number" maxlength="11" placeholder="11位手机号" value="{{phone}}" bindinput="onPhone" />

    <view class="label">职务/岗位 <text class="req">*</text></view>
    <picker mode="selector" range="{{jobTitleOptions}}" value="{{jobTitleIndex}}" bindchange="onJobTitleChange">
      <view class="picker-val">{{jobTitle || '请选择职务/岗位'}}</view>
    </picker>

    <checkbox-group class="privacy-row" bindchange="onPrivacyChange">
      <label class="privacy-label">
        <checkbox value="agree" checked="{{privacyAgreed}}" color="#3949ab" />
        <text>我已阅读并同意</text>
        <text class="privacy-link" catchtap="openPrivacy">《隐私政策与用户协议》</text>
      </label>
    </checkbox-group>

    <button class="btn-primary" loading="{{loading}}" bindtap="submit">提交注册</button>
  </view>
</view>
