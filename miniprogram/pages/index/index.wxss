.home {
  min-height: 100vh;
  background: #f5f7fb;
  color: #1f2937;
}
.hero {
  position: relative;
  height: 470rpx;
  overflow: hidden;
  padding: 46rpx 34rpx 0;
  background: linear-gradient(180deg, #0558d8 0%, #1494ff 58%, #d9f1ff 100%);
  color: #fff;
}
.hero-bg,
.hero-mask {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.hero-mask {
  background: linear-gradient(180deg, rgba(0, 55, 153, 0.35), rgba(0, 84, 190, 0.08) 54%, rgba(245, 247, 251, 0.1));
}
.hero-title {
  position: relative;
  z-index: 2;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
}
.hero-main {
  position: relative;
  z-index: 2;
  margin-top: 58rpx;
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: 0;
}
.hero-sub {
  position: relative;
  z-index: 2;
  margin-top: 20rpx;
  padding-left: 80rpx;
  font-size: 28rpx;
  letter-spacing: 8rpx;
}
.hero-scene,
.sea,
.city,
.mascot,
.helmet,
.face,
.body {
  position: absolute;
}
.hero-scene {
  left: 0;
  right: 0;
  bottom: 0;
  height: 235rpx;
}
.sea {
  left: 0;
  right: 0;
  bottom: 0;
  height: 118rpx;
  background: linear-gradient(180deg, rgba(255,255,255,0.3), #4ab5e8);
}
.city {
  left: 46rpx;
  bottom: 82rpx;
  width: 300rpx;
  height: 86rpx;
  border-radius: 80rpx 80rpx 10rpx 10rpx;
  background: linear-gradient(90deg, #f8fafc, #c6e4ff);
  box-shadow: 46rpx -18rpx 0 -4rpx #eef7ff, 112rpx -8rpx 0 -8rpx #fff;
}
.mascot {
  right: 48rpx;
  bottom: 28rpx;
  width: 150rpx;
  height: 220rpx;
}
.helmet {
  left: 20rpx;
  top: 0;
  width: 112rpx;
  height: 70rpx;
  border-radius: 60rpx 60rpx 22rpx 22rpx;
  background: #ffc928;
  box-shadow: inset 0 -10rpx 0 rgba(0,0,0,0.12);
}
.face {
  left: 34rpx;
  top: 48rpx;
  width: 84rpx;
  height: 86rpx;
  border-radius: 50%;
  background: #ffe1c7;
}
.body {
  left: 22rpx;
  bottom: 0;
  width: 108rpx;
  height: 112rpx;
  border-radius: 28rpx 28rpx 10rpx 10rpx;
  background: linear-gradient(180deg, #263b54, #172033);
  border-bottom: 12rpx solid #ffcf33;
}
.module-card {
  position: relative;
  z-index: 3;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx 8rpx;
  margin: 0 28rpx 22rpx;
  padding: 26rpx 12rpx;
  background: #fff;
  border-radius: 18rpx;
  box-shadow: 0 10rpx 34rpx rgba(20, 53, 107, 0.13);
}
.module-item {
  text-align: center;
}
.module-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  margin: 0 auto 12rpx;
  border-radius: 22rpx;
  color: #fff;
  font-size: 34rpx;
}
.module-icon.red { background: linear-gradient(145deg, #ff6b59, #f43f5e); }
.module-icon.orange { background: linear-gradient(145deg, #ffc45f, #f59e0b); }
.module-icon.blue { background: linear-gradient(145deg, #54a0ff, #2563eb); }
.module-icon.green { background: linear-gradient(145deg, #70d99d, #16a34a); }
.module-icon.cyan { background: linear-gradient(145deg, #54a0ff, #0ea5e9); }
.module-icon.amber { background: linear-gradient(145deg, #ffbf4d, #f97316); }
.module-icon.purple { background: linear-gradient(145deg, #a78bfa, #7c3aed); }
.module-title {
  font-size: 24rpx;
  color: #111827;
}
.notice-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 0 28rpx 28rpx;
  padding: 18rpx 22rpx;
  background: #fff;
  border-radius: 14rpx;
  box-shadow: 0 8rpx 24rpx rgba(20, 53, 107, 0.08);
}
.notice-label {
  color: #1266e3;
  font-weight: 700;
}
.notice-text {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 25rpx;
}
.notice-date,
.more {
  color: #8a94a6;
  font-size: 24rpx;
}
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 28rpx 28rpx 18rpx;
  font-size: 31rpx;
  font-weight: 700;
}
.activity-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin: 0 28rpx;
}
.activity-card {
  position: relative;
  overflow: hidden;
  min-height: 150rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  color: #fff;
}
.activity-card.warm {
  background: linear-gradient(135deg, #ff705f, #f59e0b);
}
.activity-card.cool {
  background: linear-gradient(135deg, #2b7fff, #06b6d4);
}
.activity-title {
  font-size: 30rpx;
  font-weight: 800;
}
.activity-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
}
.activity-card button {
  position: relative;
  z-index: 1;
  margin: 18rpx 0 0;
  padding: 0 18rpx;
  background: #fff;
  color: #1d4ed8;
}
.activity-bg {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  opacity: 0.32;
}
.activity-title,
.activity-sub {
  position: relative;
  z-index: 1;
}
.bottom-space {
  height: 150rpx;
}
.bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  align-items: end;
  min-height: 118rpx;
  padding: 12rpx 18rpx 22rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -8rpx 28rpx rgba(18, 35, 62, 0.1);
}
.nav-item {
  text-align: center;
  color: #6b7280;
  font-size: 22rpx;
}
.nav-item.active {
  color: #1266e3;
}
.nav-icon {
  font-size: 34rpx;
  line-height: 1;
  margin-bottom: 4rpx;
}
.join-wrap {
  justify-self: center;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 150rpx;
  height: 150rpx;
  margin: -58rpx auto 0;
}
.join-btn {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 150rpx;
  height: 150rpx;
  min-width: 150rpx;
  min-height: 150rpx;
  max-width: 150rpx;
  max-height: 150rpx;
  margin: 0;
  padding: 0;
  border-radius: 9999rpx;
  background: linear-gradient(180deg, #2f8cff, #1266e3);
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.2;
  text-align: center;
  box-shadow: 0 10rpx 28rpx rgba(18, 102, 227, 0.35);
}
.join-btn text {
  display: block;
  width: 96rpx;
}
.join-btn.loading {
  opacity: 0.72;
}
