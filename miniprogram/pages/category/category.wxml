<view class="page">
  <view class="header">
    <view class="title">{{name}}</view>
    <view class="subtitle">内容由网页端知识专栏维护</view>
  </view>

  <view wx:if="{{loading}}" class="state">正在加载...</view>

  <view wx:elif="{{articles.length === 0}}" class="state empty">
    <view class="empty-title">暂无内容</view>
    <view class="empty-text">请在网页端知识专栏添加栏目内容</view>
  </view>

  <view wx:else class="article-list">
    <view wx:for="{{articles}}" wx:key="id" data-index="{{index}}" class="article-item" bindtap="openArticle">
      <image wx:if="{{item.image_url}}" class="article-thumb" src="{{item.image_url}}" mode="aspectFill" />
      <view wx:elif="{{item.video_url}}" class="video-thumb">▶</view>
      <view class="article-body">
        <view class="article-title">{{item.title}}</view>
        <view wx:if="{{item.summary}}" class="article-content">{{item.summary}}</view>
      </view>
      <view class="article-arrow">›</view>
    </view>
  </view>
</view>
