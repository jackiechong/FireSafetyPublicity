.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx 44rpx;
  background: #f5f7fb;
  color: #172033;
}

.header {
  padding: 18rpx 4rpx 28rpx;
}

.title {
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.25;
}

.subtitle {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 24rpx;
}

.article-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.article-item {
  display: flex;
  gap: 20rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 6rpx 22rpx rgba(20, 53, 107, 0.08);
}

.article-item.video-item {
  display: block;
}

.article-thumb {
  flex: none;
  width: 184rpx;
  height: 132rpx;
  border-radius: 14rpx;
  background: #dbeafe;
}

.article-video {
  display: block;
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #0f172a;
}

.article-body {
  flex: 1;
  min-width: 0;
}

.video-item .article-body {
  margin-top: 18rpx;
}

.article-title {
  color: #111827;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.38;
}

.article-content {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 12rpx;
  color: #64748b;
  font-size: 26rpx;
  line-height: 1.55;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.state {
  margin-top: 120rpx;
  text-align: center;
  color: #64748b;
  font-size: 28rpx;
}

.empty {
  padding: 70rpx 28rpx;
  border-radius: 18rpx;
  background: #fff;
}

.empty-title {
  color: #111827;
  font-size: 32rpx;
  font-weight: 800;
}

.empty-text {
  margin-top: 12rpx;
  font-size: 25rpx;
}
