.page {
  padding-bottom: 48rpx;
}
.profile .row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
}
.k {
  color: #888;
}
.ok {
  color: #2e7d32;
  font-size: 26rpx;
}
.stats-module {
  margin-top: 12rpx;
}
.join-training-btn {
  width: 560rpx;
  margin: 28rpx auto 24rpx;
  border-radius: 999rpx;
  background: #1a237e;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 24rpx rgba(26, 35, 126, 0.22);
}
.join-training-btn::after {
  border: 0;
}
.stats-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a237e;
}
.stats-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #666;
}
.knowledge {
  margin-top: 16rpx;
}
.knowledge-tabs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  margin-top: 16rpx;
}
.knowledge-tab {
  background: #f3f6fb;
  border-radius: 8rpx;
  color: #455a64;
  font-size: 24rpx;
  padding: 14rpx 6rpx;
  text-align: center;
}
.knowledge-tab.active {
  background: #1a237e;
  color: #fff;
}
.knowledge-empty {
  color: #999;
  font-size: 24rpx;
  padding: 24rpx 0 8rpx;
  text-align: center;
}
.knowledge-item {
  border-top: 1rpx solid #eef1f5;
  padding: 18rpx 0;
}
.knowledge-title {
  color: #202124;
  font-size: 28rpx;
  font-weight: 700;
}
.knowledge-content {
  color: #555;
  font-size: 24rpx;
  line-height: 1.6;
  margin-top: 8rpx;
  white-space: pre-wrap;
}
.item .t {
  font-weight: 600;
  margin-bottom: 8rpx;
}
.meta {
  color: #666;
  font-size: 24rpx;
  line-height: 1.5;
}
.empty {
  text-align: center;
  color: #999;
  padding: 40rpx;
}
.logout {
  margin: 40rpx 24rpx;
  background: #fff;
  color: #c62828;
}
