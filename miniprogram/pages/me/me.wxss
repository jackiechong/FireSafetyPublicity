.page {
  padding-bottom: 48rpx;
}
.profile .row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
}
.k {
  color: #888;
}
.ok {
  color: #2e7d32;
  font-size: 26rpx;
}
.stats-module {
  margin-top: 12rpx;
}
.join-training-btn {
  width: 560rpx;
  margin: 28rpx auto 24rpx;
  border-radius: 999rpx;
  background: #1a237e;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 24rpx rgba(26, 35, 126, 0.22);
}
.join-training-btn::after {
  border: 0;
}
.stats-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a237e;
}
.stats-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #666;
}
.item .t {
  font-weight: 600;
  margin-bottom: 8rpx;
}
.meta {
  color: #666;
  font-size: 24rpx;
  line-height: 1.5;
}
.empty {
  text-align: center;
  color: #999;
  padding: 40rpx;
}
.logout {
  margin: 40rpx 24rpx;
  background: #fff;
  color: #c62828;
}
