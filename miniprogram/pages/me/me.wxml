<view class="page">
  <view class="card profile">
    <view class="row"><text class="k">微信</text><text class="ok">已绑定</text></view>
    <view class="row"><text class="k">姓名</text><text>{{person.name || '-'}}</text></view>
    <view class="row"><text class="k">手机</text><text>{{person.phone || '-'}}</text></view>
    <view class="row"><text class="k">区县</text><text>{{person.district_name || '-'}}</text></view>
    <view class="row"><text class="k">单位</text><text>{{person.organization_name || '-'}}</text></view>
    <view class="row"><text class="k">职务</text><text>{{person.job_title || '-'}}</text></view>
  </view>

  <view wx:if="{{person.is_admin}}" class="card stats-module" bindtap="goAdminTraining">
    <view class="stats-title">培训管理</view>
    <view class="stats-sub">创建培训、生成二维码并管理现场培训</view>
  </view>

  <view wx:if="{{person.is_admin}}" class="card stats-module" bindtap="goAdminStats">
    <view class="stats-title">数据回看</view>
    <view class="stats-sub">查看区县培训时长与类型占比</view>
  </view>

  <view class="card stats-module">
    <view class="stats-title">培训记录</view>
    <view class="stats-sub">查看本人已加入的培训场次</view>
  </view>

  <button wx:if="{{!person.is_admin}}" class="join-training-btn" bindtap="goCheckin">加入培训</button>

  <view class="card knowledge">
    <view class="stats-title">学习专栏</view>
    <view class="knowledge-tabs">
      <view
        wx:for="{{knowledgeCategories}}"
        wx:key="code"
        class="knowledge-tab {{activeKnowledge === item.code ? 'active' : ''}}"
        data-category="{{item.code}}"
        bindtap="onPickKnowledge"
      >{{item.name}}</view>
    </view>
    <view wx:if="{{knowledgeList.length === 0}}" class="knowledge-empty">暂无内容</view>
    <view wx:for="{{knowledgeList}}" wx:key="id" class="knowledge-item">
      <view class="knowledge-title">{{item.title}}</view>
      <view class="knowledge-content">{{item.content}}</view>
    </view>
  </view>

  <block wx:if="{{list.length === 0}}">
    <view class="empty">暂无记录（需管理端将您加入培训名单）</view>
  </block>
  <block wx:for="{{list}}" wx:key="session_id">
    <view class="card item">
      <view class="t">{{item.title}}</view>
      <view class="meta">{{item.organization_name}} · {{item.district_name}}</view>
      <view class="meta">{{item.start_at}} · {{item.duration_minutes}} 分钟</view>
    </view>
  </block>
  <button class="logout" bindtap="logout">退出登录</button>
</view>
