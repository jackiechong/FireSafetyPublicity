.page {
  padding: 24rpx;
  padding-bottom: 48rpx;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.admin-line {
  font-weight: 600;
}
.admin-sub {
  color: #666;
  font-size: 26rpx;
  margin-top: 8rpx;
}
.stats-entry {
  margin-top: 20rpx;
  margin-left: 0;
  background: #e8eaf6;
  color: #1a237e;
  font-size: 28rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin: 16rpx 0;
}
.field {
  margin-bottom: 24rpx;
}
.label {
  display: block;
  color: #666;
  font-size: 26rpx;
  margin-bottom: 8rpx;
}
.input,
.picker {
  border: 1px solid #e0e0e0;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
}
.row {
  display: flex;
  gap: 16rpx;
}
.half {
  flex: 1;
}
.btn-primary {
  background: #1a237e;
  color: #fff;
  margin-top: 8rpx;
}
.item .t {
  font-weight: 600;
}
.end-btn {
  margin-top: 16rpx;
  margin-left: 0;
  background: #fff3e0;
  color: #d66a00;
}
.meta {
  color: #888;
  font-size: 26rpx;
  margin-top: 8rpx;
}
.empty {
  color: #999;
  text-align: center;
  padding: 40rpx;
}
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}
.qr-panel {
  width: 86%;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
}
.qr-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.qr-row {
  font-size: 26rpx;
  color: #444;
  margin-bottom: 8rpx;
}
.qr-url {
  word-break: break-all;
  font-size: 24rpx;
  color: #1a237e;
  margin: 16rpx 0;
  padding: 16rpx;
  background: #f5f7fa;
  border-radius: 8rpx;
}
.close {
  margin-top: 16rpx;
}
