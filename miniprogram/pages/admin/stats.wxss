.page {
  padding: 24rpx;
  padding-bottom: 48rpx;
}
.summary {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.summary-item {
  flex: 1;
  background: #1a237e;
  color: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
}
.summary-label {
  font-size: 24rpx;
  opacity: 0.82;
}
.summary-value {
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 700;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a237e;
  margin-bottom: 20rpx;
}
.district-scroll {
  width: 100%;
  white-space: nowrap;
}
.district-list {
  display: flex;
  gap: 16rpx;
}
.district-pill {
  flex: 0 0 auto;
  min-width: 168rpx;
  border-radius: 14rpx;
  background: #f5f7fa;
  color: #333;
  padding: 18rpx;
  font-size: 26rpx;
}
.district-pill.active {
  background: #e8eaf6;
  color: #1a237e;
  font-weight: 600;
}
.pill-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #777;
}
.type-row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eee;
}
.type-row:last-child {
  border-bottom: 0;
}
.type-head {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  align-items: center;
}
.type-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}
.type-num {
  font-size: 24rpx;
  color: #666;
}
.bar {
  height: 16rpx;
  border-radius: 999rpx;
  background: #eef0f7;
  overflow: hidden;
  margin-top: 14rpx;
}
.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #3949ab;
}
.type-foot {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #888;
}
.empty {
  text-align: center;
  color: #999;
  padding: 48rpx 0;
}
