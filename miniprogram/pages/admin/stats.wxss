.page {
  padding: 24rpx;
  padding-bottom: 48rpx;
}
.period-card,
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(26, 35, 126, 0.06);
}
.period-tabs {
  display: flex;
  background: #f1f3f8;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 18rpx;
}
.period-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 10rpx;
  color: #666;
  font-size: 26rpx;
}
.period-tab.active {
  background: #1a237e;
  color: #fff;
  font-weight: 700;
}
.period-picker {
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 20rpx;
  color: #1a237e;
  font-weight: 600;
}
.summary {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.summary-item {
  flex: 1;
  background: #1a237e;
  color: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
}
.summary-label {
  font-size: 24rpx;
  opacity: 0.82;
}
.summary-value {
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 700;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a237e;
  margin-bottom: 20rpx;
}
.district-scroll {
  width: 100%;
  white-space: nowrap;
}
.district-list {
  display: flex;
  gap: 16rpx;
}
.district-pill {
  flex: 0 0 auto;
  min-width: 168rpx;
  border-radius: 14rpx;
  background: #f5f7fa;
  color: #333;
  padding: 18rpx;
  font-size: 26rpx;
}
.district-pill.active {
  background: #e8eaf6;
  color: #1a237e;
  font-weight: 600;
}
.pill-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #777;
}
.pie-canvas {
  width: 640rpx;
  height: 520rpx;
  max-width: 100%;
  margin: 0 auto 12rpx;
}
.pie-selected {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  background: #f0f2ff;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 10rpx;
}
.pie-selected-title {
  color: #1a237e;
  font-size: 28rpx;
  font-weight: 700;
}
.pie-selected-meta {
  color: #3949ab;
  font-size: 26rpx;
  font-weight: 600;
}
.legend-row,
.list-row,
.training-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}
.legend-row:last-child,
.list-row:last-child,
.training-row:last-child {
  border-bottom: 0;
}
.legend-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}
.legend-main {
  display: flex;
  align-items: center;
  min-width: 0;
}
.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex: 0 0 auto;
}
.legend-name {
  font-size: 26rpx;
  color: #222;
}
.legend-meta {
  font-size: 24rpx;
  color: #666;
  white-space: nowrap;
}
.list-row.active {
  margin: 0 -12rpx;
  padding-left: 12rpx;
  padding-right: 12rpx;
  background: #f0f2ff;
  border-radius: 12rpx;
  border-bottom-color: transparent;
}
.row-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
  line-height: 1.45;
}
.row-meta {
  margin-top: 8rpx;
  color: #777;
  font-size: 24rpx;
  line-height: 1.45;
}
.empty {
  text-align: center;
  color: #999;
  padding: 48rpx 0;
}
