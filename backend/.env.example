# 复制为 .env 后修改
SECRET_KEY=请替换为随机长字符串
DATABASE_URL=sqlite:///./data/app.db

# 本地若 8000 报 WinError 10013，请用 run.ps1 或 --port 18080

# 微信小程序（正式环境必填；本地开发可留空，将使用 dev_openid）
WECHAT_APPID=
WECHAT_SECRET=

# 微信公众号「网页授权」(OAuth2)。不使用公众号 H5 入口可全部留空。
# - WECHAT_OA_APPID / WECHAT_OA_SECRET：在公众号后台「设置与开发 → 基本配置」获取
# - WECHAT_OA_REDIRECT_HOST：必须是已在公众号后台白名单（设置与开发 → 接口权限 →
#   网页服务 → 网页帐号 → 网页授权获取用户基本信息）登记的 HTTPS 域名，
#   形如 https://fire.example.gov.cn；本地开发可留空，并改用 vite 代理同源访问 5173
WECHAT_OA_APPID=
WECHAT_OA_SECRET=
WECHAT_OA_REDIRECT_HOST=
